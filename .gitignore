# Private workspace, including coded/de-identified participant data
/data/
/data_test/
/private/
/local/
/result/
/results/
/artifacts/
/checkpoints/
/reports/*
!/reports/README.md

# Clinical exports, feature caches, spreadsheets, serialized data/models
*.edf
*.bdf
*.vhdr
*.vmrk
*.eeg
*.nwb
*.mat
*.h5
*.hdf5
