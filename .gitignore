# Notebook sources/outputs can contain IDs, clinical text and embedded images
*.ipynb
.ipynb_checkpoints/
/notebooks/*
!/notebooks/README.md

# Study configs, subject lists, audit manifests and reports are local by default
/configs/*
!/configs/README.md
!/configs/package_study/
/configs/local.json
/configs/package_study/*.local.*
/docs/*
!/docs/README.md
!/docs/data_publication_policy.md
!/docs/offline_edf_workflow.md
# Proposals and proposal reviews remain private under /docs/*.

# Cohort-bound drivers and report templates embed individual clinical details
/scripts/*
!/scripts/README.md
!/scripts/seeg_external_predict.py
/src/seizureprop/legacy/*
!/src/seizureprop/legacy/README.md
/tests/*
!/tests/test_package.py
!/tests/test_publication_guard.py
/tools/*
!/tools/README.md
!/tools/audit_repository.py
!/tools/check_publication.py

# Individual-level exports accidentally written outside private folders
**/participants.json
**/participants.jsonl
**/patient_ids.*
**/patient_manifest.*
**/patient_mapping.*
**/subject_mapping.*
**/per_patient*
**/*_patient_metrics.*
**/splits.json
**/training_provenance.json

